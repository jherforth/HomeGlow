{
  "manifestVersion": 1,
  "id": "reef",
  "version": "1.0.0",
  "author": "HomeGlow",
  "name": "Reef",
  "description": "A dive: sunlit shallows in light mode, a night dive in dark. Water gradients, coral and bioluminescent accents, bubble-soft frames.",
  "extends": "classic",
  "modes": [
    "light",
    "dark"
  ],
  "colors": {
    "primary": "#c8f4ff",
    "secondary": "#00a6c8",
    "accent": "#ff7f50"
  },
  "fonts": [
    {
      "family": "Nunito",
      "weight": 400,
      "src": "fonts/nunito-400.woff2"
    },
    {
      "family": "Nunito",
      "weight": 600,
      "src": "fonts/nunito-600.woff2"
    },
    {
      "family": "Nunito",
      "weight": 700,
      "src": "fonts/nunito-700.woff2"
    }
  ],
  "tokens": {
    "all": {
      "--hg-font-body": "'Nunito', 'Segoe UI', sans-serif",
      "--hg-font-heading": "'Nunito', 'Segoe UI', sans-serif",
      "--hg-radius-sm": "10px",
      "--hg-radius-md": "16px",
      "--hg-radius-lg": "22px",
      "--hg-frame-radius": "24px",
      "--hg-frame-decoration-width": "2px",
      "--hg-frame-decoration-style": "solid",
      "--success": "#2bb673",
      "--warning": "#f4a261",
      "--hg-error": "#e0453a",
      "--hg-error-hover": "#c7362c",
      "--hg-error-surface": "rgba(224, 69, 58, 0.14)",
      "--dock-active-image": "linear-gradient(135deg, rgba(0, 0, 0, 0) 0 38%, #ffffff 38% 62%, rgba(0, 0, 0, 0) 62%)",
      "--hg-frame-overlay": "linear-gradient(115deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.06) 28%, rgba(255, 255, 255, 0) 42%, rgba(255, 255, 255, 0) 72%, rgba(255, 255, 255, 0.07) 84%, rgba(255, 255, 255, 0) 92%)"
    },
    "light": {
      "--primary": "#c8f4ff",
      "--secondary": "#00a6c8",
      "--accent": "#ff7f50",
      "--accent-rgb": "255, 127, 80",
      "--background": "#0a5f8c",
      "--hg-page-image": "linear-gradient(180deg, #c8f4ff 0%, #5fd0e8 35%, #1a8fbf 70%, #0a5f8c 100%)",
      "--surface": "#f2fbfd",
      "--card-bg": "rgba(225, 248, 255, 0.55)",
      "--hg-frame-bg": "rgba(225, 248, 255, 0.55)",
      "--text": "#06324a",
      "--text-secondary": "#2f6d84",
      "--border": "#b8dde8",
      "--card-border": "#b8dde8",
      "--hg-hover": "rgba(0, 166, 200, 0.12)",
      "--hg-frame-decoration-color": "rgba(255, 255, 255, 0.95) rgba(255, 255, 255, 0.45) rgba(0, 50, 80, 0.35) rgba(255, 255, 255, 0.75)",
      "--hg-frame-shadow": "inset 0 2px 1px rgba(255, 255, 255, 0.8), inset 0 -4px 8px rgba(0, 50, 80, 0.22), inset 0 0 36px rgba(0, 70, 110, 0.22), 0 14px 32px rgba(2, 40, 70, 0.4)",
      "--hg-frame-shadow-hover": "inset 0 2px 1px rgba(255, 255, 255, 0.9), inset 0 -4px 8px rgba(0, 50, 80, 0.22), inset 0 0 36px rgba(0, 70, 110, 0.22), 0 18px 40px rgba(2, 40, 70, 0.5)",
      "--shadow": "0 6px 24px rgba(4, 60, 90, 0.25)",
      "--bottom-bar-bg": "rgba(240, 252, 255, 0.78)",
      "--dock-bg": "rgba(240, 252, 255, 0.78)",
      "--dock-border": "rgba(255, 255, 255, 0.9)",
      "--dock-separator": "rgba(10, 95, 140, 0.25)",
      "--dock-icon": "#0a5f8c",
      "--dock-active-bg": "#d7263d",
      "--dock-active-border": "#ffb199",
      "--dock-active-icon": "#06324a",
      "--hg-frame-image": "linear-gradient(180deg, rgba(255, 255, 255, 0.35) 0%, rgba(255, 255, 255, 0.08) 35%, rgba(0, 70, 110, 0.12) 100%)"
    },
    "dark": {
      "--primary": "#c8f4ff",
      "--secondary": "#ff7f50",
      "--accent": "#3ee6ff",
      "--accent-rgb": "62, 230, 255",
      "--background": "#010812",
      "--hg-page-image": "linear-gradient(180deg, #0b4a6e 0%, #052a45 35%, #021628 70%, #010812 100%)",
      "--surface": "#04182b",
      "--card-bg": "rgba(4, 28, 48, 0.6)",
      "--hg-frame-bg": "rgba(4, 28, 48, 0.6)",
      "--text": "#d8f6ff",
      "--text-secondary": "#7fc8dc",
      "--border": "#1d4f6b",
      "--card-border": "#1d4f6b",
      "--hg-hover": "rgba(62, 230, 255, 0.12)",
      "--hg-frame-decoration-color": "rgba(160, 240, 255, 0.55) rgba(62, 230, 255, 0.25) rgba(0, 0, 0, 0.5) rgba(120, 220, 255, 0.4)",
      "--hg-frame-shadow": "inset 0 2px 1px rgba(160, 240, 255, 0.35), inset 0 -4px 8px rgba(0, 0, 0, 0.4), inset 0 0 40px rgba(0, 0, 0, 0.45), 0 14px 36px rgba(0, 0, 0, 0.55)",
      "--hg-frame-shadow-hover": "inset 0 2px 1px rgba(160, 240, 255, 0.45), inset 0 -4px 8px rgba(0, 0, 0, 0.4), inset 0 0 40px rgba(0, 0, 0, 0.45), 0 0 32px rgba(62, 230, 255, 0.3)",
      "--shadow": "0 0 24px rgba(62, 230, 255, 0.12)",
      "--bottom-bar-bg": "rgba(2, 22, 40, 0.8)",
      "--dock-bg": "rgba(2, 22, 40, 0.8)",
      "--dock-border": "rgba(62, 230, 255, 0.35)",
      "--dock-separator": "rgba(62, 230, 255, 0.25)",
      "--dock-icon": "#9fe6f5",
      "--dock-active-bg": "#d7263d",
      "--dock-active-border": "#b6f6ff",
      "--dock-active-icon": "#021628",
      "--hg-frame-image": "linear-gradient(180deg, rgba(120, 220, 255, 0.12) 0%, rgba(120, 220, 255, 0.02) 35%, rgba(0, 0, 0, 0.25) 100%)"
    }
  },
  "mui": {
    "fontFamily": "'Nunito', 'Segoe UI', sans-serif",
    "radius": 14,
    "pillButtons": true
  },
  "muiModes": {
    "light": {
      "primary": "#ff7f50",
      "secondary": "#00a6c8",
      "error": "#e0453a",
      "background": "#e9f9fd",
      "paper": "#f7fdff",
      "text": "#06324a",
      "textSecondary": "#2f6d84",
      "divider": "#b8dde8"
    },
    "dark": {
      "primary": "#3ee6ff",
      "secondary": "#ff7f50",
      "error": "#e0453a",
      "background": "#021628",
      "paper": "#06223a",
      "text": "#d8f6ff",
      "textSecondary": "#7fc8dc",
      "divider": "#1d4f6b"
    }
  },
  "ambience": [
    {
      "effect": "caustics",
      "modes": [
        "light"
      ],
      "options": {
        "strength": "soft"
      }
    },
    {
      "effect": "bubbles",
      "options": {
        "density": "medium"
      }
    },
    {
      "effect": "seafloor",
      "modes": [
        "light"
      ],
      "options": {
        "palette": "sand"
      }
    },
    {
      "effect": "seafloor",
      "modes": [
        "dark"
      ],
      "options": {
        "palette": "night"
      }
    }
  ]
}
